<Page
    x:Class="SteamEyaWinUI.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <Grid ColumnSpacing="24" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="FormPanel" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Strings.Get('Login_Title'), Mode=OneWay}" Style="{StaticResource PageTitleTextStyle}" Visibility="Collapsed" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Login_Subtitle'), Mode=OneWay}"
                        Style="{StaticResource PageSubtitleTextStyle}" Visibility="Collapsed" />
                </StackPanel>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <SelectorBar x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged" Background="{ThemeResource AuroraGlassStrongBrush}" BorderBrush="{ThemeResource AuroraGlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                        <SelectorBarItem x:Name="LegacyEyaModeItem" Text="{x:Bind Strings.Get('Login_Mode_LegacyEya'), Mode=OneWay}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE8D4;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="TokenLoginModeItem" Text="{x:Bind Strings.Get('Login_Mode_TokenLogin'), Mode=OneWay}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE8D7;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="AutoModeItem" Text="{x:Bind Strings.Get('Login_Mode_Auto'), Mode=OneWay}" Visibility="Collapsed">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE945;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="ManualModeItem" Text="{x:Bind Strings.Get('Login_Mode_Manual'), Mode=OneWay}" Visibility="Collapsed">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="CredsModeItem" Text="{x:Bind Strings.Get('Login_Mode_Creds'), Mode=OneWay}" Visibility="Collapsed">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE72E;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>

                    <Button
                        x:Name="ClearAllButton"
                        Grid.Column="1"
                        MinWidth="112"
                        VerticalAlignment="Center"
                        Click="ClearAllButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE894;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ClearAll'), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="ManualPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Manual_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBox
                            x:Name="AccountNameBox"
                            Header="{x:Bind Strings.Get('Login_Field_AccountName'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_AccountName_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False"
                            TextChanged="ManualCredentialBox_TextChanged"
                            KeyDown="AccountNameBox_KeyDown" />

                        <TextBox
                            x:Name="EyaTokenBox"
                            Height="150"
                            Header="{x:Bind Strings.Get('Login_Field_EyaToken'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_EyaToken_Placeholder'), Mode=OneWay}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            IsSpellCheckEnabled="False"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextChanged="ManualCredentialBox_TextChanged" />

                        <Button
                            x:Name="ClearManualButton"
                            MinWidth="80"
                            HorizontalAlignment="Left"
                            Click="ClearManualButton_Click">
                            <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                </Border>
                <!-- 账密模式（调试）：用账号密码登录 Steam，换取 EYA 令牌并存入历史。 -->
                <Border x:Name="CredsPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Creds_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Creds_Section_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <TextBox
                            x:Name="CredAccountNameBox"
                            Header="{x:Bind Strings.Get('Creds_Field_AccountName'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Creds_Field_AccountName_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False" />

                        <PasswordBox
                            x:Name="CredPasswordBox"
                            Header="{x:Bind Strings.Get('Creds_Field_Password'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Creds_Field_Password_Placeholder'), Mode=OneWay}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="ClearCredsButton"
                                MinWidth="80"
                                Click="ClearCredsButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="CredFetchButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Padding="0,10"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="CredFetchButton_Click"
                                ToolTipService.ToolTip="{x:Bind Strings.Get('Creds_Btn_Fetch_Tip'), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE898;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Creds_Btn_Fetch'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="LegacyEyaPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_LegacyEya_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Login_LegacyEya_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <TextBox
                            x:Name="LegacyEyaLicenseKeyBox"
                            Header="{x:Bind Strings.Get('Login_Field_LicenseKey'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_LicenseKey_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False"
                            TextChanged="LegacyEyaLicenseKeyBox_TextChanged"
                            KeyDown="LegacyEyaLicenseKeyBox_KeyDown" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="LegacyResolvedAccountBox"
                                Header="{x:Bind Strings.Get('Login_Field_ResolvedAccount'), Mode=OneWay}"
                                IsReadOnly="True"
                                PlaceholderText="{x:Bind Strings.Get('Login_Value_NotResolved'), Mode=OneWay}" />

                            <Button
                                x:Name="ClearLegacyLicenseButton"
                                Grid.Column="1"
                                MinWidth="80"
                                VerticalAlignment="Bottom"
                                Click="ClearLegacyLicenseButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="ResolveLegacyLicenseButton"
                                Grid.Column="2"
                                MinWidth="112"
                                VerticalAlignment="Bottom"
                                Click="ResolveLegacyLicenseButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ResolveLicense'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="TokenLoginPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Token_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Login_Token_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="TokenLicenseKeyBox"
                                Header="{x:Bind Strings.Get('Login_Field_LicenseKey'), Mode=OneWay}"
                                PlaceholderText="{x:Bind Strings.Get('Login_Field_LicenseKey_Placeholder'), Mode=OneWay}"
                                IsSpellCheckEnabled="False"

                                KeyDown="TokenLicenseKeyBox_KeyDown" />

                            <Button
                                x:Name="ClearTokenButton"
                                Grid.Column="1"
                                MinWidth="80"
                                VerticalAlignment="Bottom"
                                Click="ClearTokenButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="ResolveTokenLicenseButton"
                                Grid.Column="2"
                                MinWidth="112"
                                VerticalAlignment="Bottom"
                                Click="ResolveTokenLicenseButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ResolveLicense'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBox
                            x:Name="TokenSteamIdBox"
                            Header="{x:Bind Strings.Get('Login_Field_SteamId'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_SteamId_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False"
                            TextChanged="TokenLoginBox_TextChanged" />

                        <TextBox
                            x:Name="TokenBox"
                            Height="140"
                            Header="{x:Bind Strings.Get('Login_Field_Token'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_Token_Placeholder'), Mode=OneWay}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            IsSpellCheckEnabled="False"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextChanged="TokenLoginBox_TextChanged" />
                    </StackPanel>
                </Border>
                <Border x:Name="AutoPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Auto_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="{x:Bind Strings.Get('Login_Field_UpstreamServer'), Mode=OneWay}"
                                Style="{StaticResource FieldLabelTextStyle}" />
                            <DropDownButton
                                x:Name="UpstreamServerButton"
                                MinWidth="166"
                                HorizontalAlignment="Left"
                                Style="{StaticResource UiTintDropDownButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="16" />
                                    <TextBlock x:Name="UpstreamServerText" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="UpstreamServerFlyout" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <TextBox
                            x:Name="LicenseKeyBox"
                            Header="{x:Bind Strings.Get('Login_Field_LicenseKey'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_LicenseKey_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False"
                            TextChanged="LicenseKeyBox_TextChanged"
                            KeyDown="LicenseKeyBox_KeyDown" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="ResolvedAccountBox"
                                Header="{x:Bind Strings.Get('Login_Field_ResolvedAccount'), Mode=OneWay}"
                                IsReadOnly="True"
                                PlaceholderText="{x:Bind Strings.Get('Login_Value_NotResolved'), Mode=OneWay}" />

                            <Button
                                x:Name="ClearLicenseButton"
                                Grid.Column="1"
                                MinWidth="80"
                                VerticalAlignment="Bottom"
                                Click="ClearLicenseButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="ResolveLicenseButton"
                                Grid.Column="2"
                                MinWidth="112"
                                VerticalAlignment="Bottom"
                                Click="ResolveLicenseButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ResolveLicense'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 主操作独占一行强调层级；三个次级操作等宽一行，避免与主按钮抢视觉权重。 -->
                <Grid x:Name="ActionButtonGrid" RowSpacing="12" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="LoginButton"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Stretch"
                        Padding="0,12"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="LoginButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D4;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_Login'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ClearWorkshopButton"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="ClearWorkshopButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_ClearWorkshop_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ClearWorkshop'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- 一键装配（用“配装”页保存的预设 + 当前账号 token），取代原“装备 R8”。 -->
                    <Button
                        x:Name="ApplyLoadoutButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="ApplyLoadoutButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_ApplyLoadout_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C1;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ApplyLoadout'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- 一键个性化：用「个性化」页保存的昵称+头像，设置到当前账号资料。 -->
                    <Button
                        x:Name="PersonalizeButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="PersonalizeButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_Personalize_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE779;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_Personalize'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 取消按钮仅忙碌时可见；OnBusyChanged 不禁用它，busy 期间始终可点。 -->
                <Button
                    x:Name="CancelButton"
                    HorizontalAlignment="Stretch"
                    Padding="0,10"
                    Visibility="Collapsed"
                    Click="CancelButton_Click"
                    ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_Cancel_Tip'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                        <TextBlock Text="{x:Bind Strings.Get('Common_Cancel'), Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind Strings.Get('Login_AccountInfo_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <PersonPicture
                            x:Name="AccountInfoAvatar"
                            Width="76"
                            Height="76" />
                        <TextBlock
                            x:Name="AccountInfoPersonaText"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource AuroraTextMutedBrush}" />
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind Strings.Get('Login_Label_UserName'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoUserText"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="1" Text="Steam64" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoSteamIdText"
                            Grid.Row="1"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="2" Text="{x:Bind Strings.Get('Login_Label_JwtExpires'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoExpiresText"
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="3" Text="{x:Bind Strings.Get('Login_Label_Availability'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoAvailabilityText"
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="4" Text="{x:Bind Strings.Get('Login_Label_PremierScore'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoPremierScoreText"
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="5" Text="{x:Bind Strings.Get('Login_Label_CsLevel'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoCsLevelText"
                            Grid.Row="5"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="6" Text="{x:Bind Strings.Get('Login_Label_Cooldown'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoCooldownStatusText"
                            Grid.Row="6"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="7" Text="{x:Bind Strings.Get('Login_Label_Cs2IsChina'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoCs2IsChinaText"
                            Grid.Row="7"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />
                    </Grid>

                    <Button
                        x:Name="OneClickQueryButton"
                        HorizontalAlignment="Stretch"
                        Click="OneClickQueryButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_OneClickQuery_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Common_OneClickQuery'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
