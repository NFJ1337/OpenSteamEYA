<Page
    x:Class="SteamEyaWinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        HorizontalContentAlignment="Stretch"
        Padding="32,24,32,16">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Border
                    Width="88"
                    Height="88"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    BorderThickness="1"
                    Background="{ThemeResource AuroraGlassBrush}"
                    BorderBrush="{ThemeResource AuroraGlassBorderBrush}">
                    <Image Source="ms-appx:///Assets/Logo.png" Stretch="UniformToFill" />
                </Border>

                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="账号管理喵" Style="{StaticResource PageTitleTextStyle}" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="AboutVersionText"
                        Foreground="{ThemeResource AuroraTextMutedBrush}" />

                    <!-- 本项目开源地址：紧跟在版本号下面，点链接直接打开浏览器 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            Text="{x:Bind Strings.Get('About_Repo_Line_Label'), Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            VerticalAlignment="Center" />
                        <HyperlinkButton
                            x:Name="AboutHeaderRepoLink"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="AboutHeaderRepoLink_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 左：点点关注不迷路 + 自动更新（合并成一张卡，上/下两段）  右：更新日志（实时读 release 说明） -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <!-- 合并卡：上半作者关注（点点关注不迷路），下半自动更新；整卡高度固定，更新区内容超出时卡内滚动 -->
                <Border x:Name="FollowAndUpdateCard" Height="420" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 上：点点关注不迷路（头像 + 昵称 + UID + 访问主页） -->
                        <StackPanel Grid.Row="0" Spacing="12">
                            <TextBlock
                                Text="{x:Bind Strings.Get('About_Follow_Title'), Mode=OneWay}"
                                Style="{StaticResource SectionTitleTextStyle}" />

                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <Border
                                    Width="68"
                                    Height="68"
                                    CornerRadius="34"
                                    BorderThickness="2"
                                    BorderBrush="{ThemeResource CustomUiBorderBrush}">
                                    <Image Source="ms-appx:///Assets/bilibili-author-avatar.jpg" Stretch="UniformToFill" />
                                </Border>
                                <!-- 昵称与 UID：拉开行距 + 各给行高，避免两行挤在一起 -->
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="南方见TvT"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        LineHeight="24" />
                                    <TextBlock
                                        Text="{x:Bind Strings.Get('About_Follow_Uid'), Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource AuroraTextMutedBrush}"
                                        LineHeight="20" />
                                </StackPanel>
                            </StackPanel>

                            <Button
                                x:Name="OpenBilibiliButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OpenBilibiliButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('About_Follow_Button'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 两段之间的分隔线 -->
                        <Border
                            Grid.Row="1"
                            Height="1"
                            Background="{ThemeResource AuroraGlassBorderBrush}" />

                        <!-- 下：自动更新 -->
                        <ScrollViewer
                            x:Name="UpdateSectionScroll"
                            Grid.Row="2"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock
                                        Text="{x:Bind Strings.Get('About_Update_Section'), Mode=OneWay}"
                                        Style="{StaticResource SectionTitleTextStyle}" />
                                    <ProgressRing
                                        x:Name="UpdateCheckingRing"
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Right"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                </Grid>

                                <TextBlock x:Name="AboutUpdateStatusText" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="AboutArtifactText"
                                    Style="{StaticResource FieldLabelTextStyle}"
                                    Foreground="{ThemeResource AuroraTextMutedBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="AboutUpdateCheckedText"
                                    Style="{StaticResource FieldLabelTextStyle}"
                                    Foreground="{ThemeResource AuroraTextMutedBrush}"
                                    TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="CheckUpdateButton" Click="CheckUpdateButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE895;" FontSize="16" />
                                            <TextBlock Text="{x:Bind Strings.Get('About_Btn_CheckUpdate'), Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <!-- 下载按钮始终显示；只有「有新版本」时这圈描边才变主题色并轻微呼吸（平时是透明描边，不占视觉） -->
                                    <Border
                                        x:Name="UpdateDownloadHighlight"
                                        CornerRadius="8"
                                        BorderThickness="2"
                                        BorderBrush="Transparent"
                                        Padding="2">
                                        <Button
                                            x:Name="DownloadUpdateButton"
                                            IsEnabled="False"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="DownloadUpdateButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE896;" FontSize="16" />
                                                <TextBlock Text="{x:Bind Strings.Get('About_Btn_DownloadUpdate'), Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                    <Button x:Name="OpenReleaseButton" Click="OpenReleaseButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                            <TextBlock Text="{x:Bind Strings.Get('About_Btn_ReleasePage'), Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel x:Name="UpdateDownloadProgressPanel" Spacing="6" Visibility="Collapsed">
                                    <ProgressBar
                                        x:Name="UpdateDownloadProgressBar"
                                        Minimum="0"
                                        Maximum="100"
                                        Height="6"
                                        IsIndeterminate="False"
                                        Value="0" />
                                    <Grid>
                                        <TextBlock
                                            x:Name="UpdateDownloadProgressText"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FieldLabelTextStyle}"
                                            Text=""
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="CancelDownloadButton"
                                            HorizontalAlignment="Right"
                                            Click="CancelDownloadButton_Click"
                                            Content="{x:Bind Strings.Get('Common_Cancel'), Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <!-- 右：更新日志；内容实时来自 GitHub Releases 的说明正文；与左卡等高 -->
                <Border x:Name="ChangelogCard" Grid.Column="1" Height="420" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Strings.Get('About_Changelog_Title'), Mode=OneWay}"
                                Style="{StaticResource SectionTitleTextStyle}"
                                VerticalAlignment="Center" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                                <ProgressRing
                                    x:Name="ChangelogLoadingRing"
                                    Width="16"
                                    Height="16"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="RefreshChangelogButton"
                                    Padding="8,4"
                                    Click="RefreshChangelogButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('About_Changelog_Refresh_Tooltip'), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            x:Name="ChangelogVersionText"
                            Grid.Row="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="ChangelogStatusText"
                            Grid.Row="2"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <ScrollViewer
                            x:Name="ChangelogScroll"
                            Grid.Row="2"
                            MaxHeight="300"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel x:Name="ChangelogPanel" Spacing="6" />
                        </ScrollViewer>
                    </Grid>
                </Border>            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_Title'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('About_Usage_Intro'), Mode=OneWay}"
                        Foreground="{ThemeResource AuroraTextMutedBrush}"
                        TextWrapping="Wrap" />
                    <!-- 特别强调：账号核验模块已适配 奶味验号.xyz -->
                    <TextBlock
                        Text="{x:Bind Strings.Get('About_Usage_NaiweiNote'), Mode=OneWay}"
                        Foreground="{ThemeResource CustomUiBrush}"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_ManagedAccounts'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_Query'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_Login'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_History'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_CachedAccounts'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_Loadout'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_Personalize'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_TreasureBox'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_Settings'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_Security'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="{x:Bind Strings.Get('About_Usage_Update'), Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="南方见 重制版" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        TextWrapping="Wrap"
                        LineHeight="24"
                        IsTextSelectionEnabled="True">
                        <Run Text="本重制版仅对界面 UI 进行全面重构，同时再原有基础上增加若干自定义实用小功能。" /><LineBreak />
                        <Run Text="此 UI重构 99.99%采用DeepSeek AI编写，介意请勿使用。" /><LineBreak />
                        <Run Text="如果你在使用过程中有 Bug 反馈、优化建议、新功能 或 源码 需求，欢迎添加本人 QQ：261064327。" /><LineBreak /><LineBreak />
                        <Run Text="重要声明：" Foreground="#FFFF7A93" /><LineBreak />
                        <Run Text="如果您介意因使此软件黑号登录错误或售后问题 请勿使用！请勿使用！请勿使用！" Foreground="#FFFF7A93" /><LineBreak />
                        <Run Text="以及本软件永久免费开源。若有人假借本软件名义向你收取费用，均非作者行为，请提高警惕，谨防诈骗。" Foreground="#FFFF7A93" /><LineBreak /><LineBreak />
                        <Run Text="如需原版程序，请访问下方 GitHub 开源项目地址获取。" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="https://github.com/NFJ1337/OpenSteamEYA"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource AuroraTextMutedBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="OpenGitHubButton"
                        HorizontalAlignment="Left"
                        Click="OpenGitHubButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('About_Btn_OpenGitHub'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
