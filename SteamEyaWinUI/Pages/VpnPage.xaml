<Page
    x:Class="SteamEyaWinUI.Pages.VpnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <StackPanel MaxWidth="1080" Spacing="12" HorizontalAlignment="Left">
            <!-- 更新站点：可选直连或代理站，手动检测当前选择站点延迟 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_UpdateProxy_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_UpdateProxy_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource AuroraTextMutedBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DropDownButton
                            x:Name="UpdateProxyButton"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource UiTintDropDownButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE774;" FontSize="16" />
                                <TextBlock x:Name="UpdateProxyButtonText" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="UpdateProxyFlyout" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            x:Name="UpdateProxyLatencyButton"
                            Grid.Column="1"
                            Click="UpdateProxyLatencyButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Settings_UpdateProxy_LatencyButton'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_UpdateProxy_LatencyButton'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- VPN（Clash Verge）：仅本程序访问 GitHub 时走它的本地代理端口，不动系统代理 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Vpn_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Vpn_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource AuroraTextMutedBrush}"
                        TextWrapping="Wrap" />

                    <!-- 订阅链接：填一次即可，本程序自己拉配置并拉起内核，无需启动 Clash 软件 -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="VpnSubscriptionBox"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="{x:Bind Strings.Get('Settings_Vpn_Subscription_Placeholder'), Mode=OneWay}" />
                        <Button x:Name="SaveVpnSubscriptionButton" Grid.Column="1" Click="SaveVpnSubscriptionButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71B;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Vpn_Btn_SaveSubscription'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopVpnCoreButton" Grid.Column="2" Click="StopVpnCoreButton_Click" ToolTipService.ToolTip="{x:Bind Strings.Get('Settings_Vpn_Btn_Stop'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Vpn_Btn_Stop'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ClearVpnSubscriptionButton"
                            Grid.Column="3"
                            Click="ClearVpnSubscriptionButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Settings_Vpn_Btn_ClearSubscription_Tip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Vpn_Btn_ClearSubscription'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 代理方式 / 代理模式 / 节点：用户自己选，选完立即保存，下次启动按上次的选择来 -->
                    <Grid ColumnSpacing="24" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Settings_Vpn_Takeover_Label'), Mode=OneWay}" />
                        <RadioButtons
                            x:Name="VpnTakeoverRadios"
                            Grid.Row="0"
                            Grid.Column="1"
                            MaxColumns="2"
                            SelectionChanged="VpnTakeoverRadios_SelectionChanged">
                            <RadioButton x:Name="VpnTakeoverSystemRadio" MinWidth="0" Tag="system" />
                            <RadioButton x:Name="VpnTakeoverTunRadio" MinWidth="0" Tag="tun" />
                        </RadioButtons>
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Settings_Vpn_Mode_Label'), Mode=OneWay}" />
                        <RadioButtons
                            x:Name="VpnModeRadios"
                            Grid.Row="1"
                            Grid.Column="1"
                            MaxColumns="2"
                            SelectionChanged="VpnModeRadios_SelectionChanged">
                            <RadioButton x:Name="VpnModeRuleRadio" MinWidth="0" Tag="rule" />
                            <RadioButton x:Name="VpnModeGlobalRadio" MinWidth="0" Tag="global" />
                        </RadioButtons>
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Settings_Vpn_Node_Label'), Mode=OneWay}" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Left">
                            <DropDownButton
                                x:Name="VpnNodeButton"
                                MinWidth="220"
                                Style="{StaticResource UiTintDropDownButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="16" />
                                    <TextBlock x:Name="VpnNodeButtonText" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="VpnNodeFlyout" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button
                                x:Name="RefreshVpnNodeDelayButton"
                                Click="RefreshVpnNodeDelayButton_Click"
                                ToolTipService.ToolTip="{x:Bind Strings.Get('Settings_Vpn_Btn_RefreshDelay'), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Settings_Vpn_Btn_RefreshDelay'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock
                            x:Name="VpnTakeoverHintText"
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <!-- 可执行文件路径：自动检测 / 手动更改 / 启动 -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="VpnPathText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}" />
                        <Button x:Name="DetectVpnButton" Grid.Column="1" Click="DetectVpnButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Vpn_Btn_Detect'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChangeVpnPathButton" Grid.Column="2" Click="ChangeVpnPathButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Vpn_Btn_Change'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="LaunchVpnButton" Grid.Column="3" Click="LaunchVpnButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Vpn_Btn_Launch'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 仅本程序走 VPN 的开关 + 当前状态（代理端口） -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Strings.Get('Settings_Vpn_Proxy_Label'), Mode=OneWay}" />
                            <TextBlock
                                x:Name="VpnProxyStatusText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource AuroraTextMutedBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="VpnProxyToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            OnContent="{x:Null}"
                            OffContent="{x:Null}"
                            Toggled="VpnProxyToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
