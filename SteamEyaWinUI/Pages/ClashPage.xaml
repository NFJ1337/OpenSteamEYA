<Page
    x:Class="SteamEyaWinUI.Pages.ClashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SteamEyaWinUI.Models"
    NavigationCacheMode="Required">

    <Grid Padding="32,24,32,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="5">
            <TextBlock
                Text="{x:Bind Strings.Get('Clash_Title'), Mode=OneWay}"
                Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock
                Text="{x:Bind Strings.Get('Clash_Subtitle'), Mode=OneWay}"
                Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind Strings.Get('Clash_ApiConfig'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <ProgressRing
                        x:Name="BusyRing"
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>

                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind Strings.Get('Clash_ApiUrl'), Mode=OneWay}"
                        Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox
                        x:Name="ApiUrlTextBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        PlaceholderText="{x:Bind Strings.Get('Clash_ApiUrlPlaceholder'), Mode=OneWay}"
                        Style="{StaticResource UiTintTextBoxStyle}" />
                    <Button
                        x:Name="TestConnectionButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="112"
                        Content="{x:Bind Strings.Get('Clash_TestConnection'), Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="TestConnectionButton_Click" />

                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Strings.Get('Clash_ApiSecret'), Mode=OneWay}"
                        Style="{StaticResource FieldLabelTextStyle}" />
                    <PasswordBox
                        x:Name="ApiSecretPasswordBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        PlaceholderText="{x:Bind Strings.Get('Clash_ApiSecretPlaceholder'), Mode=OneWay}"
                        PasswordRevealMode="Peek"
                        MinHeight="36"
                        Padding="12,6" />
                    <Button
                        x:Name="SaveConfigButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        MinWidth="112"
                        Content="{x:Bind Strings.Get('Clash_SaveConfig'), Mode=OneWay}"
                        Style="{StaticResource AuroraGlassButtonStyle}"
                        Click="SaveConfigButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Style="{StaticResource FieldValueTextStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="RefreshButton"
                    MinWidth="108"
                    IsEnabled="False"
                    Style="{StaticResource AuroraGlassButtonStyle}"
                    Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE72C;" FontSize="15" />
                        <TextBlock Text="{x:Bind Strings.Get('Clash_RefreshNodes'), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="TestAllButton"
                    MinWidth="132"
                    IsEnabled="False"
                    Style="{StaticResource AuroraGlassButtonStyle}"
                    Click="TestAllButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                        <TextBlock Text="{x:Bind Strings.Get('Clash_TestAll'), Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="18,14">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Strings.Get('Clash_ProxyGroup'), Mode=OneWay}"
                        Style="{StaticResource FieldLabelTextStyle}" />
                    <DropDownButton
                        x:Name="ProxyGroupButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Style="{StaticResource UiTintDropDownButtonStyle}">
                        <TextBlock
                            x:Name="ProxyGroupButtonText"
                            Text="{x:Bind Strings.Get('Clash_CurrentProxy_None'), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <DropDownButton.Flyout>
                            <!-- 与账号管理页“生成 ID”同为 MenuFlyout；只把背景改为同色不透明。 -->
                            <MenuFlyout
                                x:Name="ProxyGroupFlyout"
                                MenuFlyoutPresenterStyle="{StaticResource AuroraOpaqueMenuFlyoutPresenterStyle}" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock
                        x:Name="CurrentProxyText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource AuroraTextBodyBrush}" />
                </Grid>

                <ListView
                    x:Name="ProxyListView"
                    Grid.Row="1"
                    SelectionMode="Single"
                    SelectionChanged="ProxyListView_SelectionChanged"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ClashNodeViewModel">
                            <Grid
                                Padding="10,8"
                                ColumnSpacing="12"
                                Background="{ThemeResource CustomUiButtonBrush}"
                                CornerRadius="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Glyph="&#xE73E;"
                                    FontSize="15"
                                    Foreground="{ThemeResource CustomUiBrush}"
                                    Visibility="{x:Bind CurrentVisibility, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Type}"
                                        FontSize="12"
                                        Foreground="{ThemeResource AuroraTextMutedBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <ProgressRing
                                        Width="16"
                                        Height="16"
                                        IsActive="{x:Bind IsTesting, Mode=OneWay}"
                                        Visibility="{x:Bind TestingVisibility, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{x:Bind DelayText, Mode=OneWay}"
                                        Foreground="{x:Bind DelayBrush, Mode=OneWay}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="3"
                                    MinWidth="64"
                                    MinHeight="30"
                                    Padding="10,4"
                                    Content="{x:Bind TestButtonText, Mode=OneWay}"
                                    Style="{StaticResource AuroraGlassButtonStyle}"
                                    Click="TestNodeButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
