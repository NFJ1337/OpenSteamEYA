<Page
    x:Class="SteamEyaWinUI.Pages.LegacyAccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SteamEyaWinUI.Pages"
    RequestedTheme="Dark"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- 账号管理页专用：Auroraqua「冰态果冻」材质。这里只换视觉表现，不改任何布局尺寸。 -->
        <LinearGradientBrush x:Key="LegacyPrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFEC72B3" Offset="0" />
            <GradientStop Color="#FFB975F1" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LegacyButtonSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4AFFFFFF" Offset="0" />
            <GradientStop Color="#1FFFFFFF" Offset="0.46" />
            <GradientStop Color="#2CF472B6" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LegacyRowHoverBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#36F472B6" Offset="0" />
            <GradientStop Color="#14FFFFFF" Offset="0.52" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="LegacyDividerBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="LegacyTextPrimaryBrush" Color="#FFF9F5FF" />
        <SolidColorBrush x:Key="LegacyTextSecondaryBrush" Color="#FFD7C9DD" />
        <SolidColorBrush x:Key="LegacyTextMutedBrush" Color="#FFB7A5C4" />
        <SolidColorBrush x:Key="LegacyPinkBrush" Color="#FFF472B6" />
        <SolidColorBrush x:Key="LegacyButtonHoverBrush" Color="#4DF472B6" />
        <SolidColorBrush x:Key="LegacyButtonPressedBrush" Color="#73D45B9A" />
        <SolidColorBrush x:Key="LegacyInputSurfaceBrush" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="LegacyStatusAvailableBrush" Color="#FF5EE6A8" />
        <SolidColorBrush x:Key="LegacyStatusCooldownBrush" Color="#FFFFB65F" />
        <SolidColorBrush x:Key="LegacyStatusVacBrush" Color="#FFFF5B73" />

        <!-- 页面内按钮/输入框的 WinUI 默认交互色也调成梅粉玻璃。 -->
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#35F472B6" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#52D45B9A" />
        <SolidColorBrush x:Key="ButtonForeground" Color="#FFF9F5FF" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackground" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#47FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#381F1729" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#45FFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#69F472B6" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#A6F472B6" />
        <SolidColorBrush x:Key="TextControlForeground" Color="#FFF9F5FF" />

        <Style x:Key="LegacyIcedGlassButtonStyle" TargetType="Button" BasedOn="{StaticResource AuroraGlassButtonStyle}">
            <Setter Property="Background" Value="{StaticResource LegacyButtonSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource LegacyTextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="LegacyIcedPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Background" Value="{StaticResource LegacyPrimaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="LegacyIcedDropDownButtonStyle" TargetType="DropDownButton" BasedOn="{StaticResource UiTintDropDownButtonStyle}">
            <Setter Property="Background" Value="{StaticResource LegacyButtonSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource LegacyTextPrimaryBrush}" />
        </Style>

        <Style x:Key="LegacyQueryStepperButtonStyle" TargetType="Button" BasedOn="{StaticResource LegacyIcedGlassButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="15" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0,6,0,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="LegacySearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource UiTintTextBoxStyle}">
            <Setter Property="Background" Value="{StaticResource LegacyInputSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#4FFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource LegacyTextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="LegacyQueryThreadTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource LegacySearchTextBoxStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0,6,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="LegacyTableTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{StaticResource LegacyTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LegacyTableHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LegacyTableTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource LegacyTextMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="LegacyIcedCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="Foreground" Value="{StaticResource LegacyTextSecondaryBrush}" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CombinedStates">
                                    <VisualState x:Name="UncheckedNormal" />
                                    <VisualState x:Name="UncheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CheckCircle.Fill" Value="#4AF472B6" />
                                            <Setter Target="CheckCircle.Stroke" Value="#B3F472B6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="CheckCircle.Fill" Value="#66D45B9A" />
                                            <Setter Target="CheckCircle.Stroke" Value="#E6F472B6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedNormal">
                                        <VisualState.Setters>
                                            <Setter Target="CheckCircle.Fill" Value="{StaticResource LegacyPrimaryButtonBrush}" />
                                            <Setter Target="CheckCircle.Stroke" Value="#C7FFFFFF" />
                                            <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CheckCircle.Fill" Value="{StaticResource LegacyPrimaryButtonBrush}" />
                                            <Setter Target="CheckCircle.Stroke" Value="#FFFFFFFF" />
                                            <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="CheckCircle.Fill" Value="#FFD45B9A" />
                                            <Setter Target="CheckCircle.Stroke" Value="#E6FFFFFF" />
                                            <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                            <Setter Target="CheckCircle.Fill" Value="{StaticResource LegacyPrimaryButtonBrush}" />
                                            <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminateNormal">
                                        <VisualState.Setters>
                                            <Setter Target="CheckCircle.Fill" Value="#66F472B6" />
                                            <Setter Target="CheckCircle.Stroke" Value="#A6FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CheckCircle.Fill" Value="#80F472B6" />
                                            <Setter Target="CheckCircle.Stroke" Value="#D9FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePressed">
                                        <VisualState.Setters>
                                            <Setter Target="CheckCircle.Fill" Value="#99D45B9A" />
                                            <Setter Target="CheckCircle.Stroke" Value="#E6FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminateDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="Root">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                                        <Ellipse
                                            x:Name="CheckCircle"
                                            Fill="#24FFFFFF"
                                            Stroke="#52FFFFFF"
                                            StrokeThickness="1" />
                                        <Path
                                            x:Name="CheckGlyph"
                                            Data="M 3 9 L 7 13 L 15 4"
                                            Stroke="White"
                                            StrokeThickness="2"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>


    <!-- 页面根直接承载内容，不使用外层卡片或白边。 -->
    <Grid Padding="32,24,32,16" RowSpacing="12">
        <Grid x:Name="LegacyAccountsTabContent" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">

                    <!-- 账号管理：工具栏（添加 / 导出 / 刷新 + 5 个 ID 生成） -->
                    <StackPanel x:Name="AccountsToolbar" Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 左：新增 / 导出 / 刷新 / 生成ID -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="LegacyAddButton" Style="{StaticResource LegacyIcedPrimaryButtonStyle}" Click="LegacyAddButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Legacy_Btn_Add'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LegacyExportButton" Style="{StaticResource LegacyIcedGlassButtonStyle}" Click="LegacyExportButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Legacy_Btn_Export'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LegacyRefreshButton" Style="{StaticResource LegacyIcedGlassButtonStyle}" Click="LegacyRefreshButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Legacy_Btn_Refresh'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <DropDownButton
                                    x:Name="LegacyGenIdButton"
                                    Style="{StaticResource LegacyIcedDropDownButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Legacy_Btn_GenId_Tip'), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Legacy_Btn_GenId'), Mode=OneWay}" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="LegacyGenIdFlyout" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                            <!-- 右：搜索 + 一键查询 / 批量备注 / 删除 / 全选（右对齐） -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock
                                                                    Text="{x:Bind Strings.Get('Legacy_Search'), Mode=OneWay}"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{StaticResource LegacyTextMutedBrush}" />
                                <TextBox
                                    x:Name="LegacySearchBox"
                                    Width="200"
                                    IsSpellCheckEnabled="False"
                                    Style="{StaticResource LegacySearchTextBoxStyle}"
                                    TextChanged="LegacySearchBox_TextChanged" />
                                <Button x:Name="LegacyBatchQueryButton" Style="{StaticResource LegacyIcedGlassButtonStyle}" Click="LegacyBatchQueryButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Common_OneClickQuery'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <!-- 一键查询进行中才出现：与历史账号 / 黑号登录页同一个取消通道（AppState.CancelBusyOperation）。 -->
                                <Button x:Name="LegacyCancelQueryButton" Style="{StaticResource LegacyIcedGlassButtonStyle}" Visibility="Collapsed" Click="LegacyCancelQueryButton_Click" ToolTipService.ToolTip="{x:Bind Strings.Get('History_CancelQuery_Tooltip'), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Common_Cancel'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LegacyBatchNoteButton" Style="{StaticResource LegacyIcedGlassButtonStyle}" Click="LegacyBatchNoteButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Legacy_Btn_BatchNote'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LegacyDeleteButton" Style="{StaticResource LegacyIcedGlassButtonStyle}" Click="LegacyDeleteButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Legacy_Btn_Delete'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LegacySelectAllButton" Style="{StaticResource LegacyIcedGlassButtonStyle}" Click="LegacySelectAllButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73A;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Legacy_Btn_SelectAll'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- 左侧三个筛选框与右侧内置登录 / 一键装配 / 一键个性化同一行；按钮作用于当前高亮/右键选中的账号。 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <CheckBox
                                    x:Name="LegacyShowAvailableCheck"
                                    Content="{x:Bind Strings.Get('Legacy_Filter_Available'), Mode=OneWay}"
                                    Style="{StaticResource LegacyIcedCheckBoxStyle}"
                                    Checked="LegacyFilter_Changed"
                                    Unchecked="LegacyFilter_Changed" />
                                <CheckBox
                                    x:Name="LegacyShowRemarkedCheck"
                                    Content="{x:Bind Strings.Get('Legacy_Filter_Remarked'), Mode=OneWay}"
                                    Style="{StaticResource LegacyIcedCheckBoxStyle}"
                                    Checked="LegacyFilter_Changed"
                                    Unchecked="LegacyFilter_Changed" />
                                <CheckBox
                                    x:Name="LegacyShowHiddenCheck"
                                    Content="{x:Bind Strings.Get('Legacy_Filter_Hidden'), Mode=OneWay}"
                                    Style="{StaticResource LegacyIcedCheckBoxStyle}"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Legacy_Filter_Hidden_Tip'), Mode=OneWay}"
                                    Checked="LegacyShowHiddenCheck_Changed"
                                    Unchecked="LegacyShowHiddenCheck_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="LegacyBatchGroupButton" Style="{StaticResource LegacyIcedGlassButtonStyle}" ToolTipService.ToolTip="{x:Bind Strings.Get('History_BatchGroup_Tooltip'), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Common_BatchGroup'), Mode=OneWay}" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="LegacyBatchGroupFlyout" Opening="LegacyBatchGroupFlyout_Opening" />
                                    </Button.Flyout>
                                </Button>
                                <DropDownButton
                                    x:Name="LegacyGroupFilterButton"
                                    MinWidth="128"
                                    Style="{StaticResource LegacyIcedDropDownButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('History_Group_Filter_Tooltip'), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                                        <TextBlock x:Name="LegacyGroupFilterText" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="LegacyGroupFilterFlyout" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button
                                    x:Name="LegacyManageGroupsButton"
                                    Style="{StaticResource LegacyIcedGlassButtonStyle}"
                                    Click="LegacyManageGroupsButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('History_Group_Manage'), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                </Button>
                                <Button
                                    x:Name="LegacyInternalLoginButton"
                                    Visibility="Collapsed"
                                    Style="{StaticResource LegacyIcedGlassButtonStyle}"
                                    Click="LegacyInternalLoginButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Legacy_InternalLogin_Tip'), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE77B;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Legacy_InternalLogin_Button'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="LegacyApplyLoadoutButton"
                                    Style="{StaticResource LegacyIcedGlassButtonStyle}"
                                    Click="LegacyApplyLoadoutButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_ApplyLoadout_Tip'), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ApplyLoadout'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="LegacyPersonalizeButton"
                                    Style="{StaticResource LegacyIcedGlassButtonStyle}"
                                    Click="LegacyPersonalizeButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_Personalize_Tip'), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE779;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('Login_Btn_Personalize'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <!-- 推送CS2配置：等同设置页「CS2 设置同步 → 立即推送」。 -->
                                <Button
                                    x:Name="LegacyPushCs2ConfigButton"
                                    Style="{StaticResource LegacyIcedGlassButtonStyle}"
                                    Click="LegacyPushCs2ConfigButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Cs2Push_Button_Tip'), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE753;" FontSize="14" />
                                            <TextBlock Text="{x:Bind Strings.Get('Cs2Push_Button'), Mode=OneWay}" />
                                        </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- 表头 + 表格本体 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="LegacyHeaderGrid"
                        ColumnSpacing="6"
                        Padding="6,8"
                        Background="{ThemeResource AuroraPaneBrush}"
                        CornerRadius="12,12,0,0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{StaticResource LegacyDividerBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="0.35*" MinWidth="40" />
                            <ColumnDefinition Width="1.1*" MinWidth="100" />
                            <ColumnDefinition Width="0.98*" MinWidth="107" />
                            <ColumnDefinition Width="0.7*" MinWidth="105" />
                            <ColumnDefinition Width="0.8*" MinWidth="70" />
                            <ColumnDefinition Width="2*" MinWidth="240" />
                            <ColumnDefinition Width="1*" MinWidth="110" />
                            <ColumnDefinition Width="1.42*" MinWidth="125" />
                            <ColumnDefinition Width="0.7*" MinWidth="82" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('Legacy_Col_Index'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Strings.Get('Legacy_Col_Account'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Strings.Get('Legacy_Query_Col_Persona'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Strings.Get('Legacy_Col_Password'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Strings.Get('Legacy_Col_Status'), Mode=OneWay}" Margin="-4,0,0,0" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="6" Text="{x:Bind Strings.Get('Legacy_Col_Cooldown'), Mode=OneWay}" Margin="-4,0,0,0" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="7" Text="{x:Bind Strings.Get('Legacy_Col_Cs2Playtime'), Mode=OneWay}" Margin="6,0,0,0" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="8" Text="{x:Bind Strings.Get('Legacy_Col_Note'), Mode=OneWay}" Margin="6,0,0,0" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                        <TextBlock Grid.Column="9" Text="{x:Bind Strings.Get('Legacy_Col_Others'), Mode=OneWay}" Margin="6,0,0,0" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    </Grid>

                    <ListView
                        x:Name="LegacyAccountList"
                        Grid.Row="1"
                        SelectionMode="None"
                        Background="{ThemeResource AuroraPaneBrush}"
                        CornerRadius="0,0,12,12"
                        ItemsSource="{x:Bind Rows, Mode=OneWay}"
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                        ScrollViewer.VerticalScrollMode="Enabled">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="6,4,6,4" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LegacyAccountRow">
                                <Grid
                                    ColumnSpacing="6"
                                    Background="Transparent"
                                    PointerEntered="LegacyAccountRow_PointerEntered"
                                    PointerExited="LegacyAccountRow_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="0.35*" MinWidth="40" />
                                        <ColumnDefinition Width="1.1*" MinWidth="100" />
                                        <ColumnDefinition Width="0.98*" MinWidth="107" />
                                        <ColumnDefinition Width="0.7*" MinWidth="105" />
                                        <ColumnDefinition Width="0.8*" MinWidth="70" />
                                        <ColumnDefinition Width="2*" MinWidth="240" />
                                        <ColumnDefinition Width="1*" MinWidth="110" />
                                        <ColumnDefinition Width="1.42*" MinWidth="125" />
                                        <ColumnDefinition Width="0.7*" MinWidth="82" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="10" Background="{x:Bind HoverBrush, Mode=OneWay}" CornerRadius="8" IsHitTestVisible="False" />
                                    <Border Grid.ColumnSpan="10" Background="{x:Bind HighlightBrush, Mode=OneWay}" CornerRadius="8" IsHitTestVisible="False" />
                                    <CheckBox
                                        Grid.Column="0"
                                        MinWidth="0"
                                        Style="{StaticResource LegacyIcedCheckBoxStyle}"
                                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                    <!-- 透明命中层覆盖复选框列：支持按住左键纵向拖选，不改变列布局。 -->
                                    <Border
                                        Grid.Column="0"
                                        Background="Transparent"
                                        Tag="checkbox" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind IndexText}" TextTrimming="CharacterEllipsis" Style="{StaticResource LegacyTableTextStyle}" />
                                    <!-- 只有右键「账号」这一列才弹登录菜单 -->
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind AccountName}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource LegacyTableTextStyle}"
                                        Tag="account"
                                        IsDoubleTapEnabled="True"
                                        DoubleTapped="LegacyAccountCell_DoubleTapped"
                                        RightTapped="LegacyAccountRow_RightTapped" HorizontalAlignment="Stretch"
                                        MinHeight="20"
                                        />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind PersonaName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource LegacyTableTextStyle}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{x:Bind PasswordText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource LegacyTableTextStyle}"
                                        Tag="password"
                                        IsDoubleTapEnabled="True"
                                        DoubleTapped="LegacyAccountCell_DoubleTapped" HorizontalAlignment="Stretch"
                                        MinHeight="20"
                                        />
                                    <TextBlock Grid.Column="5" Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" Margin="-4,0,0,0" TextTrimming="CharacterEllipsis" Style="{StaticResource LegacyTableTextStyle}" />
                                    <TextBlock
                                        Grid.Column="8"
                                        Text="{x:Bind Note, Mode=OneWay}"
                                        Margin="6,0,0,0"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource LegacyTableTextStyle}"
                                        Tag="note"
                                        RightTapped="LegacyAccountCell_RightTapped" HorizontalAlignment="Stretch"
                                        MinHeight="20"
                                        />
                                    <TextBlock
                                        Grid.Column="9"
                                        Text="{x:Bind OthersText, Mode=OneWay}"
                                        Margin="6,0,0,0"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource LegacyTableTextStyle}"
                                        Tag="others"
                                        IsDoubleTapEnabled="True"
                                        DoubleTapped="LegacyAccountCell_DoubleTapped"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="20"
                                        />
                                    <TextBlock
                                        Grid.Column="7"
                                        Text="{x:Bind Cs2PlaytimeText, Mode=OneWay}"
                                        Margin="6,0,0,0"
                                        TextTrimming="CharacterEllipsis"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource LegacyTableTextStyle}" />
                                    <!-- 冷却时间（冷却结束的绝对时间）：右键可改冷却 -->
                                    <TextBlock
                                        Grid.Column="6"
                                        Text="{x:Bind CooldownEndText, Mode=OneWay}"
                                        Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                        Margin="-4,0,0,0"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource LegacyTableTextStyle}"
                                        Tag="cooldownEnd"
                                        RightTapped="LegacyAccountCell_RightTapped"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="20"
                                        />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
            </Grid>

            <!-- 账号管理底栏：与账号查询底栏同模板，统计当前可见账号 -->
            <Border Grid.Row="2" Background="{ThemeResource AuroraPaneBrush}" CornerRadius="12" Padding="12,8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="LegacyManagementLocateLastLoginButton"
                            Grid.Column="0"
                            Padding="10,4"
                            MinHeight="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource LegacyIcedGlassButtonStyle}"
                            Click="LegacyManagementLocateLastLoginButton_Click">
                            <TextBlock Text="{x:Bind Strings.Get('Legacy_LastLoginAccount_Locate'), Mode=OneWay}" />
                        </Button>
                        <TextBlock
                            x:Name="LegacyManagementLastLoginAccountText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource LegacyTextSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="16"
                        HorizontalAlignment="Right">
                        <TextBlock
                            x:Name="LegacyManagementSelectedCountText"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource LegacyTextMutedBrush}" />
                        <TextBlock
                            x:Name="LegacyManagementTotalCountText"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource LegacyTextSecondaryBrush}" />
                        <TextBlock
                            x:Name="LegacyManagementAvailableCountText"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource LegacyStatusAvailableBrush}" />
                        <TextBlock
                            x:Name="LegacyManagementCooldownCountText"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource LegacyStatusCooldownBrush}" />
                        <TextBlock
                            x:Name="LegacyManagementVacCountText"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource LegacyStatusVacBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- 左侧导航「账号管理 / 账号查询」的独立查询视图 -->
        <Grid x:Name="LegacyAccountQueryTabContent" RowSpacing="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="LegacyAccountQueryStartButton"
                        Style="{StaticResource LegacyIcedPrimaryButtonStyle}"
                        Click="LegacyAccountQueryStartButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="LegacyAccountQueryStartIcon" Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Name="LegacyAccountQueryStartText" Text="{x:Bind Strings.Get('Legacy_Query_Start'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="LegacyAccountQueryStopButton"
                        IsEnabled="False"
                        Style="{StaticResource LegacyIcedGlassButtonStyle}"
                        Click="LegacyAccountQueryStopButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                            <TextBlock Text="{x:Bind Strings.Get('Legacy_Query_Stop'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="LegacyAccountQueryContinueButton"
                        Style="{StaticResource LegacyIcedGlassButtonStyle}"
                        Click="LegacyAccountQueryContinueButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72A;" FontSize="14" />
                            <TextBlock Text="{x:Bind Strings.Get('Legacy_Query_Continue'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="LegacyAccountQueryExportButton"
                        Style="{StaticResource LegacyIcedGlassButtonStyle}"
                        Click="LegacyAccountQueryExportButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="{x:Bind Strings.Get('Legacy_Query_ExportSelected'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="LegacyAccountQueryDeleteButton"
                        Style="{StaticResource LegacyIcedGlassButtonStyle}"
                        Click="LegacyAccountQueryDeleteButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="{x:Bind Strings.Get('Legacy_Query_DeleteSelected'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="LegacyAccountQueryRefreshButton"
                        Style="{StaticResource LegacyIcedGlassButtonStyle}"
                        Click="LegacyAccountQueryRefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="{x:Bind Strings.Get('Legacy_Btn_Refresh'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="LegacyAccountQueryResetButton"
                        Style="{StaticResource LegacyIcedGlassButtonStyle}"
                        Click="LegacyAccountQueryResetButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                            <TextBlock Text="{x:Bind Strings.Get('Legacy_Query_Reset'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <CheckBox
                        x:Name="LegacyAccountQueryFailedOnlyCheck"
                        Content="{x:Bind Strings.Get('Legacy_Query_FailedOnly'), Mode=OneWay}"
                        IsChecked="False"
                        Checked="LegacyAccountQueryFailedOnlyCheck_Changed"
                        Unchecked="LegacyAccountQueryFailedOnlyCheck_Changed"
                        Style="{StaticResource LegacyIcedCheckBoxStyle}" />
                </StackPanel>

                <DropDownButton
                    x:Name="LegacyAccountQuerySelectOptionsButton"
                    Grid.Column="1"
                    Style="{StaticResource LegacyIcedDropDownButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind Strings.Get('Legacy_Query_SelectOptions'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B3;" FontSize="14" />
                        <TextBlock Text="{x:Bind Strings.Get('Legacy_Query_SelectOptions'), Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind Strings.Get('Common_SelectAll'), Mode=OneWay}" Click="LegacyAccountQuerySelectAll_Click" />
                            <MenuFlyoutItem Text="{x:Bind Strings.Get('Legacy_Query_SelectInvert'), Mode=OneWay}" Click="LegacyAccountQuerySelectInvert_Click" />
                            <MenuFlyoutItem Text="{x:Bind Strings.Get('Common_ClearSelection'), Mode=OneWay}" Click="LegacyAccountQuerySelectNone_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind Strings.Get('Legacy_Query_SelectUnbanned'), Mode=OneWay}" Click="LegacyAccountQuerySelectUnbanned_Click" />
                            <MenuFlyoutItem Text="{x:Bind Strings.Get('Legacy_Query_SelectBanned'), Mode=OneWay}" Click="LegacyAccountQuerySelectBanned_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind Strings.Get('Legacy_Query_SelectLevel2'), Mode=OneWay}" Click="LegacyAccountQuerySelectLevel2_Click" />
                            <MenuFlyoutItem Text="{x:Bind Strings.Get('Legacy_Query_SelectAvailableLevel2'), Mode=OneWay}" Click="LegacyAccountQuerySelectAvailableLevel2_Click" />
                            <MenuFlyoutItem Text="{x:Bind Strings.Get('Legacy_Query_SelectBannedLevel2'), Mode=OneWay}" Click="LegacyAccountQuerySelectBannedLevel2_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind Strings.Get('Legacy_Query_SelectQueried'), Mode=OneWay}" Click="LegacyAccountQuerySelectQueried_Click" />
                            <MenuFlyoutItem Text="{x:Bind Strings.Get('Legacy_Query_SelectNotQueried'), Mode=OneWay}" Click="LegacyAccountQuerySelectNotQueried_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <Border
                Grid.Row="1"
                Background="{ThemeResource AuroraPaneBrush}"
                CornerRadius="12"
                Padding="12,8">
                <ScrollViewer
                    x:Name="LegacyAccountQueryOptionsScrollViewer"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    PointerWheelChanged="LegacyAccountQueryOptionsScrollViewer_PointerWheelChanged">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <CheckBox
                            x:Name="LegacyAccountQueryRankCheck"
                            Content="{x:Bind Strings.Get('Legacy_Query_QueryRank'), Mode=OneWay}"
                            IsChecked="False"
                            Style="{StaticResource LegacyIcedCheckBoxStyle}" />
                        <CheckBox
                            x:Name="LegacyAccountQueryUserInfoCheck"
                            Content="{x:Bind Strings.Get('Legacy_Query_QueryUserInfo'), Mode=OneWay}"
                            IsChecked="False"
                            Style="{StaticResource LegacyIcedCheckBoxStyle}" />
                        <CheckBox
                            x:Name="LegacyAccountQueryBanTimeCheck"
                            Content="{x:Bind Strings.Get('Legacy_Query_QueryBanTime'), Mode=OneWay}"
                            IsChecked="False"
                            Style="{StaticResource LegacyIcedCheckBoxStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <CheckBox
                                x:Name="LegacyAccountQueryChangeNameCheck"
                                Content="{x:Bind Strings.Get('Legacy_Query_ChangeName'), Mode=OneWay}"
                                Checked="LegacyAccountQueryChangeNameCheck_Changed"
                                Unchecked="LegacyAccountQueryChangeNameCheck_Changed"
                                Style="{StaticResource LegacyIcedCheckBoxStyle}" />
                            <TextBox
                                x:Name="LegacyAccountQueryNewNameBox"
                                Width="150"
                                IsEnabled="False"
                                IsSpellCheckEnabled="False"
                                PlaceholderText="{x:Bind Strings.Get('Legacy_Query_NewNamePlaceholder'), Mode=OneWay}"
                                Style="{StaticResource LegacySearchTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <CheckBox
                                x:Name="LegacyAccountQueryChangeAvatarCheck"
                                Content="{x:Bind Strings.Get('Legacy_Query_ChangeAvatar'), Mode=OneWay}"
                                Checked="LegacyAccountQueryChangeAvatarCheck_Changed"
                                Unchecked="LegacyAccountQueryChangeAvatarCheck_Changed"
                                Style="{StaticResource LegacyIcedCheckBoxStyle}" />
                            <Button
                                x:Name="LegacyAccountQueryAvatarButton"
                                Content="{x:Bind Strings.Get('Legacy_Query_SelectAvatar'), Mode=OneWay}"
                                IsEnabled="False"
                                Style="{StaticResource LegacyIcedGlassButtonStyle}"
                                Click="LegacyAccountQueryAvatarButton_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <CheckBox
                                x:Name="LegacyAccountQueryChangeSummaryCheck"
                                Content="{x:Bind Strings.Get('Legacy_Query_ChangeSummary'), Mode=OneWay}"
                                Checked="LegacyAccountQueryChangeSummaryCheck_Changed"
                                Unchecked="LegacyAccountQueryChangeSummaryCheck_Changed"
                                Style="{StaticResource LegacyIcedCheckBoxStyle}" />
                            <TextBox
                                x:Name="LegacyAccountQueryNewSummaryBox"
                                Width="200"
                                IsEnabled="False"
                                IsSpellCheckEnabled="False"
                                PlaceholderText="{x:Bind Strings.Get('Legacy_Query_NewSummaryPlaceholder'), Mode=OneWay}"
                                Style="{StaticResource LegacySearchTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind Strings.Get('Legacy_Query_Threads'), Mode=OneWay}"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource LegacyTextSecondaryBrush}" />
                            <Grid Width="136" ColumnSpacing="4" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="LegacyAccountQueryThreadTextBox"
                                    VerticalAlignment="Center"
                                    MaxLength="10"
                                    Text="2"
                                    TextAlignment="Center"
                                    IsSpellCheckEnabled="False"
                                    Style="{StaticResource LegacyQueryThreadTextBoxStyle}"
                                    FocusVisualPrimaryThickness="0"
                                    FocusVisualSecondaryThickness="0"
                                    TextChanged="LegacyAccountQueryThreadTextBox_TextChanged"
                                    Loaded="LegacyAccountQueryThreadTextBox_Loaded"
                                    LostFocus="LegacyAccountQueryThreadTextBox_LostFocus"
                                    KeyDown="LegacyAccountQueryThreadTextBox_KeyDown">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#B3F472B6" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#73F472B6" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#52FFFFFF" />
                                    </TextBox.Resources>
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScope.Names>
                                                <InputScopeName NameValue="Number" />
                                            </InputScope.Names>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <RepeatButton
                                        Width="32"
                                        Height="16"
                                        Style="{StaticResource ThemedNumberBoxSpinButtonStyle}"
                                        Click="LegacyAccountQueryThreadIncrementButton_Click">
                                        <FontIcon Glyph="&#xE70E;" FontSize="7" />
                                    </RepeatButton>
                                    <RepeatButton
                                        Width="32"
                                        Height="16"
                                        Style="{StaticResource ThemedNumberBoxSpinButtonStyle}"
                                        Click="LegacyAccountQueryThreadDecrementButton_Click">
                                        <FontIcon Glyph="&#xE70D;" FontSize="7" />
                                    </RepeatButton>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="LegacyAccountQueryHeaderGrid"
                    ColumnSpacing="8"
                    Padding="6,8"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource AuroraPaneBrush}"
                    CornerRadius="12,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="0.45*" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="0.42*" />
                        <ColumnDefinition Width="0.46*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.53*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Strings.Get('Legacy_Query_Col_Select'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('Legacy_Col_Index'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Strings.Get('Legacy_Col_Account'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Strings.Get('Legacy_Col_Status'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="4" Text="{x:Bind Strings.Get('Legacy_Query_Col_Persona'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="5" Text="{x:Bind Strings.Get('Legacy_Col_Cs2Playtime'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="6" Text="{x:Bind Strings.Get('Legacy_Query_Col_Rank'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="7" Text="{x:Bind Strings.Get('Legacy_Query_Col_LastLogin'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="8" Text="{x:Bind Strings.Get('Legacy_Query_Col_Region'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="9" Text="{x:Bind Strings.Get('Legacy_Query_Col_China'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="10" Text="{x:Bind Strings.Get('Legacy_Query_Col_SteamId'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="11" Text="{x:Bind Strings.Get('Legacy_Query_Col_BanTime'), Mode=OneWay}" Style="{StaticResource LegacyTableHeaderTextStyle}" />
                </Grid>

                <ListView
                    x:Name="LegacyAccountQueryList"
                    Grid.Row="1"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="LegacyAccountQueryList_ItemClick"
                    SizeChanged="LegacyAccountQueryList_SizeChanged"
                    Background="{ThemeResource AuroraPaneBrush}"
                    CornerRadius="0,0,12,12"
                    ItemsSource="{x:Bind AccountQueryRows, Mode=OneWay}"
                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                    ScrollViewer.VerticalScrollMode="Enabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LegacyAccountQueryRow">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="0.45*" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="0.42*" />
                                    <ColumnDefinition Width="0.46*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.53*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.ColumnSpan="12"
                                    Background="{x:Bind HighlightBrush, Mode=OneWay}"
                                    CornerRadius="8"
                                    IsHitTestVisible="False" />
                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                    Style="{StaticResource LegacyIcedCheckBoxStyle}"
                                    HorizontalAlignment="Center" />
                                <!-- 透明命中层覆盖复选框列：按住左键纵向滑动可连续多选。 -->
                                <Border
                                    Grid.Column="0"
                                    Background="Transparent"
                                    Tag="checkbox" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind IndexText}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource LegacyTableTextStyle}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind AccountName}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource LegacyTableTextStyle}"
                                    Tag="account"
                                    RightTapped="LegacyAccountQueryAccountCell_RightTapped"
                                    IsDoubleTapEnabled="True"
                                    DoubleTapped="LegacyAccountQueryAccountCell_DoubleTapped"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="20" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind StatusDetail, Mode=OneWay}"
                                    Style="{StaticResource LegacyTableTextStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind PersonaName, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource LegacyTableTextStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Cs2PlaytimeText, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource LegacyTableTextStyle}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind RankText, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource LegacyTableTextStyle}" />
                                <TextBlock Grid.Column="7" Text="{x:Bind LastLoginText, Mode=OneWay}" Style="{StaticResource LegacyTableTextStyle}" />
                                <TextBlock Grid.Column="8" Text="{x:Bind RegionText, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource LegacyTableTextStyle}" />
                                <TextBlock Grid.Column="9" Text="{x:Bind ChinaSteamText, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource LegacyTableTextStyle}" />
                                <TextBlock
                                    Grid.Column="10"
                                    Text="{x:Bind SteamIdText, Mode=OneWay}"
                                    Style="{StaticResource LegacyTableTextStyle}"
                                    HorizontalAlignment="Stretch"
                                    IsDoubleTapEnabled="True"
                                    DoubleTapped="LegacyAccountQuerySteamId_DoubleTapped" />
                                <TextBlock
                                    Grid.Column="11"
                                    Text="{x:Bind BanTimeText, Mode=OneWay}"
                                    Foreground="{x:Bind BanTimeBrush, Mode=OneWay}"
                                    Style="{StaticResource LegacyTableTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Row="3" Background="{ThemeResource AuroraPaneBrush}" CornerRadius="12" Padding="12,8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" ColumnSpacing="8" MaxWidth="520">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="LegacyAccountQueryLocateLastLoginButton"
                            Grid.Column="0"
                            Padding="10,4"
                            MinHeight="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource LegacyIcedGlassButtonStyle}"
                            Click="LegacyAccountQueryLocateLastLoginButton_Click">
                            <TextBlock Text="{x:Bind Strings.Get('Legacy_LastLoginAccount_Locate'), Mode=OneWay}" />
                        </Button>
                        <TextBlock
                            x:Name="LegacyAccountQueryLastLoginAccountText"
                            Grid.Column="1"
                            MaxWidth="430"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource LegacyTextSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock x:Name="LegacyAccountQueryStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource LegacyTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LegacyAccountQuerySelectedCountText" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource LegacyTextMutedBrush}" />
                    <TextBlock x:Name="LegacyAccountQuerySuccessCountText" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource LegacyStatusAvailableBrush}" />
                    <TextBlock x:Name="LegacyAccountQueryTotalCountText" Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource LegacyTextSecondaryBrush}" />
                    <TextBlock x:Name="LegacyAccountQueryLastRunText" Grid.Column="5" VerticalAlignment="Center" Foreground="{StaticResource LegacyTextMutedBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Page>
