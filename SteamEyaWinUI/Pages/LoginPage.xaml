<Page
    x:Class="SteamEyaWinUI.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SteamEyaWinUI.Models"
    xmlns:loc="using:SteamEyaWinUI.Localization"
    NavigationCacheMode="Required"
    SizeChanged="LoginPage_SizeChanged">

    <Page.Resources>
        <!-- 两个模式名称（Token登录 / 账号核验）下方那条蓝条 = SelectorBar 的 PART_SelectionVisual；
             它默认只有 4×3，这里只在黑号登录页把它拉长（按钮本身尺寸不动）。 -->
        <x:Double x:Key="SelectorBarItemPillWidth">62</x:Double>
        <x:Double x:Key="SelectorBarItemPillHeight">3</x:Double>
        <!-- 核验模块专用模板：站点信息密度高，这里统一走小字号 + 细边卡片，压进一屏。 -->
        <DataTemplate x:Key="VerifyStatTemplate" x:DataType="models:SteamVerifyStat">
            <Border
                Margin="0,0,0,8"
                Padding="10,8"
                CornerRadius="10"
                Background="{ThemeResource AuroraPaneBrush}"
                BorderBrush="{ThemeResource AuroraGlassBorderBrush}"
                BorderThickness="1">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Value}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind ValueBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind Note}"
                        Style="{StaticResource FieldLabelTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VerifyRecordRowTemplate" x:DataType="models:SteamVerifyRecordRow">
            <Grid Padding="4,6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{x:Bind Map}"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Record}"
                    FontSize="13"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind Rank}"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="3"
                    Text="{x:Bind LastMatch}"
                    FontSize="13"
                    Foreground="{ThemeResource AuroraTextMutedBrush}"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VerifyGameRowTemplate" x:DataType="models:SteamVerifyGameRow">
            <Grid Padding="4,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind Name}"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressBar Height="4" Maximum="100" Value="{x:Bind BarPercent}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind PlaytimeText}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind SecondaryText}"
                    FontSize="12"
                    Foreground="{ThemeResource AuroraTextMutedBrush}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <!-- 宽度随窗口适配：刻意不给网格写 MaxWidth —— WinUI 对「MaxWidth + Stretch」的元素会做居中，
             窗口一拉宽内容就会整体右移并停止变宽。 -->
        <Grid x:Name="LayoutGrid" ColumnSpacing="24" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="FormPanel" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Strings.Get('Login_Title'), Mode=OneWay}" Style="{StaticResource PageTitleTextStyle}" Visibility="Collapsed" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Login_Subtitle'), Mode=OneWay}"
                        Style="{StaticResource PageSubtitleTextStyle}" Visibility="Collapsed" />
                </StackPanel>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <SelectorBar x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged" Background="{ThemeResource AuroraGlassStrongBrush}" BorderBrush="{ThemeResource AuroraGlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                        <!-- 黑号存储：攒还没登录过的卡密（按来源导入、验号、删除、送去 Token 登录）—— 放在 Token登录 左边 -->
                        <SelectorBarItem x:Name="CardStoreModeItem" Text="{x:Bind Strings.Get('Login_Mode_CardStore'), Mode=OneWay}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE777;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="TokenLoginModeItem" Text="{x:Bind Strings.Get('Login_Mode_TokenLogin'), Mode=OneWay}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE8D7;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="VerifyModeItem" Text="{x:Bind Strings.Get('Login_Mode_Verify'), Mode=OneWay}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE73E;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="LegacyEyaModeItem" Text="{x:Bind Strings.Get('Login_Mode_LegacyEya'), Mode=OneWay}" Visibility="Collapsed">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE8D4;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="AutoModeItem" Text="{x:Bind Strings.Get('Login_Mode_Auto'), Mode=OneWay}" Visibility="Collapsed">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE945;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="ManualModeItem" Text="{x:Bind Strings.Get('Login_Mode_Manual'), Mode=OneWay}" Visibility="Collapsed">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="CredsModeItem" Text="{x:Bind Strings.Get('Login_Mode_Creds'), Mode=OneWay}" Visibility="Collapsed">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE72E;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>

                    <Button
                        x:Name="ClearAllButton"
                        Grid.Column="1"
                        MinWidth="112"
                        VerticalAlignment="Center"
                        Click="ClearAllButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE894;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ClearAll'), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="ManualPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Manual_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBox
                            x:Name="AccountNameBox"
                            Header="{x:Bind Strings.Get('Login_Field_AccountName'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_AccountName_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False"
                            TextChanged="ManualCredentialBox_TextChanged"
                            KeyDown="AccountNameBox_KeyDown" />

                        <TextBox
                            x:Name="EyaTokenBox"
                            Height="150"
                            Header="{x:Bind Strings.Get('Login_Field_EyaToken'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_EyaToken_Placeholder'), Mode=OneWay}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            IsSpellCheckEnabled="False"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextChanged="ManualCredentialBox_TextChanged" />

                        <Button
                            x:Name="ClearManualButton"
                            MinWidth="80"
                            HorizontalAlignment="Left"
                            Click="ClearManualButton_Click">
                            <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                </Border>
                <!-- 账密模式（调试）：用账号密码登录 Steam，换取 EYA 令牌并存入历史。 -->
                <Border x:Name="CredsPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Creds_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Creds_Section_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <TextBox
                            x:Name="CredAccountNameBox"
                            Header="{x:Bind Strings.Get('Creds_Field_AccountName'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Creds_Field_AccountName_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False" />

                        <PasswordBox
                            x:Name="CredPasswordBox"
                            Header="{x:Bind Strings.Get('Creds_Field_Password'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Creds_Field_Password_Placeholder'), Mode=OneWay}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="ClearCredsButton"
                                MinWidth="80"
                                Click="ClearCredsButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="CredFetchButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Padding="0,10"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="CredFetchButton_Click"
                                ToolTipService.ToolTip="{x:Bind Strings.Get('Creds_Btn_Fetch_Tip'), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE898;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Creds_Btn_Fetch'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="LegacyEyaPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_LegacyEya_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Login_LegacyEya_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <TextBox
                            x:Name="LegacyEyaLicenseKeyBox"
                            Header="{x:Bind Strings.Get('Login_Field_LicenseKey'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_LicenseKey_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False"
                            TextChanged="LegacyEyaLicenseKeyBox_TextChanged"
                            KeyDown="LegacyEyaLicenseKeyBox_KeyDown" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="LegacyResolvedAccountBox"
                                Header="{x:Bind Strings.Get('Login_Field_ResolvedAccount'), Mode=OneWay}"
                                IsReadOnly="True"
                                PlaceholderText="{x:Bind Strings.Get('Login_Value_NotResolved'), Mode=OneWay}" />

                            <Button
                                x:Name="ClearLegacyLicenseButton"
                                Grid.Column="1"
                                MinWidth="80"
                                VerticalAlignment="Bottom"
                                Click="ClearLegacyLicenseButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="ResolveLegacyLicenseButton"
                                Grid.Column="2"
                                MinWidth="112"
                                VerticalAlignment="Bottom"
                                Click="ResolveLegacyLicenseButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ResolveLicense'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- 黑号存储：上面一张卡片负责导入（文本框铺满，来源/导入按钮/提示在下面一行），
                     下面单独一张表格卡片放已存卡密，表格样式与「账号管理」页一致。 -->
                <StackPanel x:Name="CardStorePanel" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind Strings.Get('CardStore_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                Text="{x:Bind Strings.Get('CardStore_Desc'), Mode=OneWay}"
                                Foreground="{ThemeResource AuroraTextMutedBrush}"
                                TextWrapping="Wrap" />

                            <TextBox
                                x:Name="CardStoreImportBox"
                                Header="{x:Bind Strings.Get('CardStore_Import_Header'), Mode=OneWay}"
                                PlaceholderText="{x:Bind Strings.Get('CardStore_Import_Placeholder'), Mode=OneWay}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Height="132"
                                HorizontalAlignment="Stretch"
                                IsSpellCheckEnabled="False" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DropDownButton
                                    x:Name="CardStoreSourceButton"
                                    Grid.Column="0"
                                    MinWidth="150"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource UiTintDropDownButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                                        <TextBlock x:Name="CardStoreSourceText" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="CardStoreSourceFlyout" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <Button
                                    x:Name="CardStoreImportButton"
                                    Grid.Column="1"
                                    MinWidth="150"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="CardStoreImportButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Strings.Get('CardStore_Import_Button'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind Strings.Get('CardStore_Import_Hint'), Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource AuroraTextMutedBrush}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 已存卡密：独立表格卡片 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid
                                Grid.Row="0"
                                ColumnSpacing="14"
                                Padding="12,8,12,8"
                                Background="{ThemeResource AuroraTableHeaderBrush}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource AuroraGlassBorderBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" MinWidth="240" />
                                    <ColumnDefinition Width="Auto" MinWidth="90" />
                                    <ColumnDefinition Width="2*" MinWidth="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Strings.Get('CardStore_Col_Key'), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('CardStore_Col_Source'), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Strings.Get('CardStore_Col_Status'), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Strings.Get('CardStore_Col_Actions'), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AuroraTextMutedBrush}" />
                            </Grid>

                            <TextBlock
                                x:Name="CardStoreEmptyText"
                                Grid.Row="1"
                                Margin="12,10,12,4"
                                Text="{x:Bind Strings.Get('CardStore_Empty'), Mode=OneWay}"
                                Foreground="{ThemeResource AuroraTextMutedBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <ListView
                                x:Name="CardStoreList"
                                Grid.Row="2"
                                MaxHeight="380"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,4,12,4" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CardKeyEntry">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" MinWidth="240" />
                                                <ColumnDefinition Width="Auto" MinWidth="90" />
                                                <ColumnDefinition Width="2*" MinWidth="200" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind Key, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    TextTrimming="None"
                                                    Tag="{x:Bind}"
                                                    IsDoubleTapEnabled="True"
                                                    DoubleTapped="CardStoreKeyCell_DoubleTapped"
                                                    ToolTipService.ToolTip="{x:Bind Key, Mode=OneWay}"
                                                    VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind SourceText, Mode=OneWay}"
                                                Foreground="{ThemeResource AuroraTextMutedBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind StatusText, Mode=OneWay}"
                                                Foreground="{ThemeResource AuroraTextMutedBrush}"
                                                TextWrapping="Wrap"
                                                ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}"
                                                VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button
                                                    MinWidth="0"
                                                    Padding="10,4"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    Click="CardStoreGoLoginButton_Click">
                                                    <TextBlock Text="{loc:Localize Key=CardStore_Btn_GoLogin}" />
                                                </Button>
                                                <Button
                                                    MinWidth="0"
                                                    Padding="10,4"
                                                    Style="{StaticResource AuroraGlassButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    Click="CardStoreDeleteButton_Click">
                                                    <TextBlock Text="{loc:Localize Key=CardStore_Btn_Delete}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
                <Border x:Name="TokenLoginPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Token_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Login_Token_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <!-- 上游服务器：奶味（默认）/ 伊万 / 路飞 —— 这张卡密去哪个上游取名（伊万/路飞 已并入本页） -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind Strings.Get('Login_Field_UpstreamServer'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                            <DropDownButton
                                x:Name="TokenUpstreamButton"
                                MinWidth="166"
                                HorizontalAlignment="Left"
                                Style="{StaticResource UiTintDropDownButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                                    <TextBlock x:Name="TokenUpstreamText" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="TokenUpstreamFlyout" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="TokenLicenseKeyBox"
                                Header="{x:Bind Strings.Get('Login_Field_LicenseKey'), Mode=OneWay}"
                                PlaceholderText="{x:Bind Strings.Get('Login_Field_LicenseKey_Placeholder'), Mode=OneWay}"
                                IsSpellCheckEnabled="False"

                                KeyDown="TokenLicenseKeyBox_KeyDown" />

                            <Button
                                x:Name="ClearTokenButton"
                                Grid.Column="1"
                                MinWidth="80"
                                VerticalAlignment="Bottom"
                                Click="ClearTokenButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="ResolveTokenLicenseButton"
                                Grid.Column="2"
                                MinWidth="112"
                                VerticalAlignment="Bottom"
                                Click="ResolveTokenLicenseButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ResolveLicense'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ResolveAndLoginButton"
                                Grid.Column="3"
                                MinWidth="132"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ResolveAndLoginButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D4;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ResolveAndLogin'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBox
                            x:Name="TokenSteamIdBox"
                            Header="{x:Bind Strings.Get('Login_Field_SteamId'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_SteamId_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False"
                            TextChanged="TokenLoginBox_TextChanged" />

                        <TextBox
                            x:Name="TokenBox"
                            Height="140"
                            Header="{x:Bind Strings.Get('Login_Field_Token'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_Token_Placeholder'), Mode=OneWay}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            IsSpellCheckEnabled="False"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextChanged="TokenLoginBox_TextChanged" />
                    </StackPanel>
                </Border>
                <!-- 奶味验号.xyz：复刻 Steam 账号核验站的验号结果——封禁状态、CS2 竞技记录与游戏库。
                     版式按软件默认窗口（1380x810）压缩：小字号、细边卡片、列表各自内部滚动、游戏库默认折叠。 -->
                <Border x:Name="VerifyPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Verify_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Login_Verify_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource AuroraTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <!-- 上游服务公告/状态：来自 111.170.18.37:9095 的 /api/v1/health（只属于核验模块） -->
                        <InfoBar
                            x:Name="VerifyServiceBar"
                            IsOpen="False"
                            IsClosable="True"
                            Severity="Informational" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="VerifyKeyBox"
                                Header="{x:Bind Strings.Get('Login_Field_LicenseKey'), Mode=OneWay}"
                                PlaceholderText="{x:Bind Strings.Get('Login_Verify_Key_Placeholder'), Mode=OneWay}"
                                IsSpellCheckEnabled="False"
                                KeyDown="VerifyKeyBox_KeyDown" />

                            <Button
                                x:Name="ClearVerifyButton"
                                Grid.Column="1"
                                MinWidth="80"
                                VerticalAlignment="Bottom"
                                Click="ClearVerifyButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="VerifyQueryButton"
                                Grid.Column="2"
                                MinWidth="112"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="VerifyQueryButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                                    <TextBlock x:Name="VerifyQueryButtonText" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 卡密一键登录：只用核验模块内的这张卡密走新版取名接口（SSE /api/v1/redeem），
                             成功后切到 Token登录 并把 SteamID/Token 填好，再交给既有登录流程。
                             不改动既有面板的行为，也不清理 Steam 账号缓存。 -->
                        <StackPanel Spacing="6" Visibility="Collapsed">
                            <TextBlock
                                Text="{x:Bind Strings.Get('Login_Verify_Login_Hint'), Mode=OneWay}"
                                Foreground="{ThemeResource AuroraTextMutedBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="VerifyRedeemLoginButton"
                                HorizontalAlignment="Stretch"
                                Padding="0,12"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="VerifyRedeemLoginButton_Click"
                                ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_RedeemAndLogin_Tip'), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D4;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Btn_RedeemAndLogin'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 登录前可选操作：与 Token登录 面板完全相同的三个按钮（点击后切到 Token登录 面板，
                             并调用该面板既有按钮的同一个处理函数；登录/这些操作都走 SteamID + JWT 的 Token 逻辑）。 -->
                        <StackPanel Spacing="6" Visibility="Collapsed">
                            <TextBlock
                                Text="{x:Bind Strings.Get('Login_Verify_PreLoginActions_Hint'), Mode=OneWay}"
                                Foreground="{ThemeResource AuroraTextMutedBrush}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="VerifyClearWorkshopButton"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,10"
                                    Click="VerifyClearWorkshopButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_ClearWorkshop_Tip'), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                        <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ClearWorkshop'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="VerifyApplyLoadoutButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,10"
                                    Click="VerifyApplyLoadoutButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_ApplyLoadout_Tip'), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7C1;" FontSize="16" />
                                        <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ApplyLoadout'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="VerifyPersonalizeButton"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,10"
                                    Click="VerifyPersonalizeButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_Personalize_Tip'), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE779;" FontSize="16" />
                                        <TextBlock Text="{x:Bind Strings.Get('Login_Btn_Personalize'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="VerifyProgressPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                            <ProgressRing Width="18" Height="18" IsActive="True" />
                            <TextBlock
                                x:Name="VerifyProgressText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AuroraTextMutedBrush}" />
                        </StackPanel>

                        <InfoBar
                            x:Name="VerifyErrorBar"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Error" />

                        <StackPanel x:Name="VerifyResultPanel" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    x:Name="VerifyHeadIcon"
                                    FontSize="22"
                                    VerticalAlignment="Center"
                                    Glyph="&#xE73E;" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="VerifyHeadlineText" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="VerifySublineText"
                                        FontSize="12"
                                        Foreground="{ThemeResource AuroraTextMutedBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Border
                                    x:Name="VerifyCachedBadge"
                                    Grid.Column="2"
                                    Padding="8,3"
                                    CornerRadius="10"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource AuroraPillBrush}">
                                    <TextBlock
                                        Text="{x:Bind Strings.Get('Login_Verify_Cached_Badge'), Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                </Border>
                            </Grid>

                            <StackPanel x:Name="VerifyPresencePanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <FontIcon x:Name="VerifyPresenceIcon" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="VerifyPresenceText"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AuroraTextMutedBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 8 项状态四列两行（每列两格），与站点 stat-grid 的阅读顺序一致。 -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl x:Name="VerifyStatsColumn0" ItemTemplate="{StaticResource VerifyStatTemplate}" />
                                <ItemsControl x:Name="VerifyStatsColumn1" Grid.Column="1" ItemTemplate="{StaticResource VerifyStatTemplate}" />
                                <ItemsControl x:Name="VerifyStatsColumn2" Grid.Column="2" ItemTemplate="{StaticResource VerifyStatTemplate}" />
                                <ItemsControl x:Name="VerifyStatsColumn3" Grid.Column="3" ItemTemplate="{StaticResource VerifyStatTemplate}" />
                            </Grid>

                            <InfoBar x:Name="VerifyCooldownBar" IsOpen="False" IsClosable="False" Severity="Warning" />

                            <StackPanel x:Name="VerifyRecordsPanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="{x:Bind Strings.Get('Login_Verify_Records_Title'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                                <Grid Padding="4,0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Verify_Col_Mode'), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('Login_Verify_Col_Record'), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Strings.Get('Login_Verify_Col_Rank'), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Strings.Get('Login_Verify_Col_LastMatch'), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                </Grid>
                                <ListView
                                    x:Name="VerifyRecordList"
                                    Height="132"
                                    SelectionMode="None"
                                    ItemTemplate="{StaticResource VerifyRecordRowTemplate}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="4,0" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </StackPanel>

                            <InfoBar x:Name="VerifyLibraryErrorBar" IsOpen="False" IsClosable="False" Severity="Warning" />

                            <!-- 游戏库默认折叠：条目多，展开后由列表自身滚动，不改页面高度。 -->
                            <Expander
                                x:Name="VerifyLibraryExpander"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                IsExpanded="False"
                                Visibility="Collapsed">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="14" />
                                        <TextBlock x:Name="VerifyLibraryHeaderText" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        x:Name="VerifyLibraryFetchedText"
                                        FontSize="12"
                                        Foreground="{ThemeResource AuroraTextMutedBrush}" />

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="VerifyLibraryTotalLabel" Style="{StaticResource FieldLabelTextStyle}" />
                                            <TextBlock x:Name="VerifyLibraryTotalValue" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="VerifyLibraryTotalNote" Style="{StaticResource FieldLabelTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="VerifyLibraryTimeLabel" Style="{StaticResource FieldLabelTextStyle}" />
                                            <TextBlock x:Name="VerifyLibraryTimeValue" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="VerifyLibraryTimeNote" Style="{StaticResource FieldLabelTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock x:Name="VerifyLibraryRecentLabel" Style="{StaticResource FieldLabelTextStyle}" />
                                            <TextBlock x:Name="VerifyLibraryRecentValue" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="VerifyLibraryRecentNote" Style="{StaticResource FieldLabelTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="2">
                                            <TextBlock x:Name="VerifyLibraryLongestLabel" Style="{StaticResource FieldLabelTextStyle}" />
                                            <TextBlock x:Name="VerifyLibraryLongestValue" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="VerifyLibraryLongestNote" Style="{StaticResource FieldLabelTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="VerifyLibrarySearchBox"
                                            PlaceholderText="{x:Bind Strings.Get('Login_Verify_Library_Search_Placeholder'), Mode=OneWay}"
                                            IsSpellCheckEnabled="False"
                                            TextChanged="VerifyLibrarySearchBox_TextChanged" />
                                        <TextBlock
                                            x:Name="VerifyLibraryCountText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FieldLabelTextStyle}" />
                                        <DropDownButton
                                            x:Name="VerifyLibrarySortButton"
                                            Grid.Column="2"
                                            Style="{StaticResource UiTintDropDownButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                                                <TextBlock x:Name="VerifyLibrarySortText" />
                                            </StackPanel>
                                            <DropDownButton.Flyout>
                                                <MenuFlyout x:Name="VerifyLibrarySortFlyout" />
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <SelectorBar
                                            x:Name="VerifyLibraryTabSelector"
                                            Grid.Column="3"
                                            Padding="2"
                                            Background="{ThemeResource AuroraGlassStrongBrush}"
                                            BorderBrush="{ThemeResource AuroraGlassBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            SelectionChanged="VerifyLibraryTabSelector_SelectionChanged">
                                            <SelectorBarItem x:Name="VerifyLibraryRecentTabItem" Text="{x:Bind Strings.Get('Login_Verify_Library_Tab_Recent'), Mode=OneWay}" />
                                            <SelectorBarItem x:Name="VerifyLibraryAllTabItem" Text="{x:Bind Strings.Get('Login_Verify_Library_Tab_All'), Mode=OneWay}" />
                                        </SelectorBar>
                                    </Grid>

                                    <ListView
                                        x:Name="VerifyLibraryList"
                                        Height="216"
                                        SelectionMode="None"
                                        ItemTemplate="{StaticResource VerifyGameRowTemplate}">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="4,0" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>

                                    <TextBlock
                                        x:Name="VerifyLibraryEmptyText"
                                        Visibility="Collapsed"
                                        Foreground="{ThemeResource AuroraTextMutedBrush}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="AutoPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Auto_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBox
                            x:Name="LicenseKeyBox"
                            Header="{x:Bind Strings.Get('Login_Field_LicenseKey'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_LicenseKey_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False"
                            TextChanged="LicenseKeyBox_TextChanged"
                            KeyDown="LicenseKeyBox_KeyDown" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="ResolvedAccountBox"
                                Header="{x:Bind Strings.Get('Login_Field_ResolvedAccount'), Mode=OneWay}"
                                IsReadOnly="True"
                                PlaceholderText="{x:Bind Strings.Get('Login_Value_NotResolved'), Mode=OneWay}" />

                            <Button
                                x:Name="ClearLicenseButton"
                                Grid.Column="1"
                                MinWidth="80"
                                VerticalAlignment="Bottom"
                                Click="ClearLicenseButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="ResolveLicenseButton"
                                Grid.Column="2"
                                MinWidth="112"
                                VerticalAlignment="Bottom"
                                Click="ResolveLicenseButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ResolveLicense'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 取消按钮仅忙碌时可见；放在操作区顶部，避免窗口较矮时被登录/装配按钮挤到视口之外。 -->
                <Button
                    x:Name="CancelButton"
                    HorizontalAlignment="Stretch"
                    Padding="0,10"
                    Visibility="Collapsed"
                    Click="CancelButton_Click"
                    ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_Cancel_Tip'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                        <TextBlock Text="{x:Bind Strings.Get('Common_Cancel'), Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <!-- 主操作独占一行强调层级；三个次级操作等宽一行，避免与主按钮抢视觉权重。 -->
                <Grid x:Name="ActionButtonGrid" RowSpacing="12" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="LoginButton"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Stretch"
                        Padding="0,12"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="LoginButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D4;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_Login'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ClearWorkshopButton"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="ClearWorkshopButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_ClearWorkshop_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ClearWorkshop'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- 一键装配（用“配装”页保存的预设 + 当前账号 token），取代原“装备 R8”。 -->
                    <Button
                        x:Name="ApplyLoadoutButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="ApplyLoadoutButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_ApplyLoadout_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C1;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ApplyLoadout'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- 一键个性化：用「个性化」页保存的昵称+头像，设置到当前账号资料。 -->
                    <Button
                        x:Name="PersonalizeButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="PersonalizeButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_Personalize_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE779;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_Personalize'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>

            <Border x:Name="AccountInfoPanel" Grid.Column="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind Strings.Get('Login_AccountInfo_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <PersonPicture
                            x:Name="AccountInfoAvatar"
                            Width="76"
                            Height="76" />
                        <TextBlock
                            x:Name="AccountInfoPersonaText"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource AuroraTextMutedBrush}" />
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind Strings.Get('Login_Label_UserName'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoUserText"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="1" Text="Steam64" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoSteamIdText"
                            Grid.Row="1"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="2" Text="{x:Bind Strings.Get('Login_Label_JwtExpires'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoExpiresText"
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="3" Text="{x:Bind Strings.Get('Login_Label_Availability'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoAvailabilityText"
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="4" Text="{x:Bind Strings.Get('Login_Label_PremierScore'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoPremierScoreText"
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="5" Text="{x:Bind Strings.Get('Login_Label_CsLevel'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoCsLevelText"
                            Grid.Row="5"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="6" Text="{x:Bind Strings.Get('Login_Label_Cooldown'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoCooldownStatusText"
                            Grid.Row="6"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="7" Text="{x:Bind Strings.Get('Login_Label_Cs2IsChina'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoCs2IsChinaText"
                            Grid.Row="7"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />
                    </Grid>

                    <Button
                        x:Name="OneClickQueryButton"
                        HorizontalAlignment="Stretch"
                        Click="OneClickQueryButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_OneClickQuery_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Common_OneClickQuery'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
