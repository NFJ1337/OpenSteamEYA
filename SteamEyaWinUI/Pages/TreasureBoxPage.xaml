<Page
    x:Class="SteamEyaWinUI.Pages.TreasureBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <StackPanel MaxWidth="820" Spacing="14" HorizontalAlignment="Left">
            <!-- 顶部提示：下面这些只是推荐链接，程序不参与其运营 -->
            <Border
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,9">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        Glyph="&#xE7BA;"
                        FontSize="16"
                        VerticalAlignment="Top"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('TreasureBox_SitesDisclaimer'), Mode=OneWay}"
                        TextWrapping="Wrap"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="4">
                <TextBlock
                    Text="{x:Bind Strings.Get('TreasureBox_Title'), Mode=OneWay}"
                    Style="{StaticResource PageTitleTextStyle}" Visibility="Collapsed" />
                <TextBlock
                    Text="{x:Bind Strings.Get('TreasureBox_Subtitle'), Mode=OneWay}"
                    Style="{StaticResource PageSubtitleTextStyle}" Visibility="Collapsed" />
            </StackPanel>

            <!-- 机密卡片 + 一键获取18位UID：同一套样式左右并排 -->
            <Grid ColumnSpacing="14">
                <!-- 左列 Auto：红色机密卡片宽度跟着文本走（一行放得下就一行）；右列吃掉剩余宽度 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="SecretCardButton"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    MaxWidth="560"
                    HorizontalContentAlignment="Stretch"
                    Padding="18"
                    CornerRadius="16"
                    Background="#38DC2626"
                    BorderBrush="#99EF4444"
                    BorderThickness="1"
                    Click="SecretCardButton_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#55DC2626" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#70DC2626" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFEF4444" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFDC2626" />
                    </Button.Resources>
                    <TextBlock
                        Text="{x:Bind Strings.Get('TreasureBox_SecretCard'), Mode=OneWay}"
                        Foreground="#FFFF6B81"
                        FontSize="18"
                        FontWeight="SemiBold"
                        LineHeight="28"
                        TextWrapping="Wrap" />
                </Button>

                <Button
                    x:Name="UidCardButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Padding="18"
                    CornerRadius="16"
                    Background="#38DC2626"
                    BorderBrush="#99EF4444"
                    BorderThickness="1"
                    Click="UidCardButton_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#55DC2626" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#70DC2626" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFEF4444" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFDC2626" />
                    </Button.Resources>
                    <TextBlock
                        Text="{x:Bind Strings.Get('TreasureBox_UidCard'), Mode=OneWay}"
                        Foreground="#FFFF6B81"
                        FontSize="18"
                        FontWeight="SemiBold"
                        LineHeight="28"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- 按钮分两列：左边是点开清单弹窗的，右边是直接用浏览器跳转的（机密卡与 UID 卡保持原样在上面）。 -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左列：点开弹窗 -->
                <StackPanel Grid.Column="0" Spacing="14">
                <!-- 推荐卡网：弹窗与「查看Cheat官网」同款（标签 + 可点链接）。 -->
            <Button
                x:Name="CardSitesButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                CornerRadius="12"
                Padding="14,7"
                FontWeight="SemiBold"
                Click="CardSitesButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="CardSitesIcon" Glyph="&#xE8C7;" FontSize="16" />
                    <TextBlock x:Name="CardSitesLabel" Text="{x:Bind Strings.Get('TreasureBox_CardSitesButton'), Mode=OneWay}" />
                </StackPanel>
            </Button>

                <!-- 常规科技官网速查：点了弹窗，弹窗里是 标签 + 可点链接（不影响上面两个按钮） -->
            <Button
                x:Name="CheatSitesButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                CornerRadius="12"
                Padding="14,7"
                FontWeight="SemiBold"
                Click="CheatSitesButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="CheatSitesIcon" Glyph="&#xE774;" FontSize="16" />
                    <TextBlock x:Name="CheatSitesLabel" Text="{x:Bind Strings.Get('TreasureBox_CheatSitesButton'), Mode=OneWay}" />
                </StackPanel>
            </Button>

                <!-- HVH 服务器：弹窗与上面几个清单同款（标签 + 可点链接）。 -->
            <Button
                x:Name="HvhServersButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                CornerRadius="12"
                Padding="14,7"
                FontWeight="SemiBold"
                Click="HvhServersButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="HvhServersIcon" Glyph="&#xE968;" FontSize="16" />
                    <TextBlock x:Name="HvhServersLabel" Text="{x:Bind Strings.Get('TreasureBox_HvhServersButton'), Mode=OneWay}" />
                </StackPanel>
            </Button>
                </StackPanel>

                <!-- 右列：直接跳转 -->
                <StackPanel Grid.Column="1" Spacing="14">
                <!-- 梯子推荐：点开弹窗的样式与上面 Cheat 官网弹窗一致 -->
            <Button
                x:Name="ProxySiteButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                CornerRadius="12"
                Padding="14,7"
                FontWeight="SemiBold"
                Click="ProxySiteButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ProxySiteIcon" Glyph="&#xE774;" FontSize="16" />
                    <TextBlock x:Name="ProxySiteLabel" Text="{x:Bind Strings.Get('TreasureBox_ProxySite'), Mode=OneWay}" />
                </StackPanel>
            </Button>

                <!-- 好看的精品壁纸网站：与上面「梯子推荐」同款样式，点击用系统默认浏览器打开。 -->
            <Button
                x:Name="WallpaperSiteButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                CornerRadius="12"
                Padding="14,7"
                FontWeight="SemiBold"
                Click="WallpaperSiteButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="WallpaperSiteIcon" Glyph="&#xE91B;" FontSize="16" />
                    <TextBlock x:Name="WallpaperSiteLabel" Text="{x:Bind Strings.Get('TreasureBox_WallpaperSite'), Mode=OneWay}" />
                </StackPanel>
            </Button>

                <!-- 枫喵 CS2 LUA 注入器：点击直接用系统默认浏览器打开。 -->
            <Button
                x:Name="LuaInjectorButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                CornerRadius="12"
                Padding="14,7"
                FontWeight="SemiBold"
                Click="LuaInjectorButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="LuaInjectorIcon" Glyph="&#xE943;" FontSize="16" />
                    <TextBlock x:Name="LuaInjectorLabel" Text="{x:Bind Strings.Get('TreasureBox_LuaInjectorButton'), Mode=OneWay}" />
                </StackPanel>
            </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>