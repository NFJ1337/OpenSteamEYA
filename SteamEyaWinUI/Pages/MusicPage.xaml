<Page
    x:Class="SteamEyaWinUI.Pages.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <!-- 用 Grid 而不是 ScrollViewer：网页区吃掉剩余高度，窗口拉大/缩小时跟着自适应 -->
    <!-- 横向内边距压到 16：这部分留白直接让给网页，减少出横向滚动条的机会 -->
    <Grid Padding="16,20,16,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="10">
                <TextBlock
                    Text="{x:Bind Strings.Get('Personalization_Music_Section'), Mode=OneWay}"
                    Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock
                    Text="{x:Bind Strings.Get('Personalization_Music_Notice'), Mode=OneWay}"
                    Foreground="{ThemeResource AuroraTextMutedBrush}"
                    TextWrapping="Wrap" />
                <!-- 平台选择：与设置页「选择语言」用同一套下拉样式（UiTintDropDownButtonStyle + MenuFlyout） -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Strings.Get('Personalization_Music_Platform'), Mode=OneWay}" />
                    <DropDownButton
                        x:Name="MusicPlatformButton"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        Style="{StaticResource UiTintDropDownButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                            <TextBlock x:Name="MusicPlatformButtonText" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="MusicPlatformFlyout" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        x:Name="MusicSetDefaultButton"
                        VerticalAlignment="Center"
                        Style="{StaticResource AuroraGlassButtonStyle}"
                        Click="MusicSetDefaultButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Music_Btn_SetDefault_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="MusicSetDefaultIcon" Glyph="&#xE718;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Music_Btn_SetDefault'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 工具条：刷新 / 后退 / 回首页 / 静音 / 缩放 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button
                x:Name="MusicRefreshButton"
                Click="MusicRefreshButton_Click"
                ToolTipService.ToolTip="{x:Bind Strings.Get('Music_Btn_Refresh'), Mode=OneWay}">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
            <Button
                x:Name="MusicBackButton"
                Click="MusicBackButton_Click"
                ToolTipService.ToolTip="{x:Bind Strings.Get('Music_Btn_Back'), Mode=OneWay}">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <Button
                x:Name="MusicHomeButton"
                Click="MusicHomeButton_Click"
                ToolTipService.ToolTip="{x:Bind Strings.Get('Music_Btn_Home'), Mode=OneWay}">
                <FontIcon Glyph="&#xE80F;" FontSize="16" />
            </Button>
            <Button
                x:Name="MusicMuteButton"
                Click="MusicMuteButton_Click"
                ToolTipService.ToolTip="{x:Bind Strings.Get('Music_Btn_Mute'), Mode=OneWay}">
                <FontIcon x:Name="MusicMuteIcon" Glyph="&#xE767;" FontSize="16" />
            </Button>
            <Button
                x:Name="MusicZoomOutButton"
                Click="MusicZoomOutButton_Click"
                ToolTipService.ToolTip="{x:Bind Strings.Get('Music_Btn_ZoomOut'), Mode=OneWay}">
                <FontIcon Glyph="&#xE71F;" FontSize="16" />
            </Button>
            <Button
                x:Name="MusicZoomInButton"
                Click="MusicZoomInButton_Click"
                ToolTipService.ToolTip="{x:Bind Strings.Get('Music_Btn_ZoomIn'), Mode=OneWay}">
                <FontIcon Glyph="&#xE8A3;" FontSize="16" />
            </Button>
        </StackPanel>

        <!-- 平台官方网页：填满剩余空间（最小高度兜底，避免窗口很小时挤成一条） -->
        <WebView2
            x:Name="MusicWebView"
            Grid.Row="2"
            MinHeight="240"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
    </Grid>
</Page>